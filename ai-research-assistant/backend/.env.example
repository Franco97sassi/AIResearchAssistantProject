GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
MAX_CONTEXT_TOKENS=6000
EMBEDDING_PROVIDER=hashing
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
HASHING_EMBEDDING_FEATURES=384
CHROMA_DIR=chroma_db
CHROMA_COLLECTION_NAME=research_papers
HISTORY_DIR=history
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RETRIEVAL_MODE=dense
RERANKING_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LOG_DIR=logs
METRICS_DB_PATH=logs/metrics.sqlite3
AUTH_REQUIRED=false
# JSON API-key -> tenant. En staging, usa secretos y no confirmes claves reales.
API_KEY_TENANTS={}
TRACE_RETENTION_DAYS=30
REDIS_URL=redis://redis:6379/0
JOB_TIMEOUT_SECONDS=900
JOB_MAX_RETRIES=3
JOB_RETRY_INTERVAL_SECONDS=30
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-research-assistant-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
