# Copie fuera del repositorio o inyecte estas variables desde su gestor de secretos.
AUTH_REQUIRED=true
API_KEY_TENANTS={"replace-with-a-long-random-key":"production"}
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
EMBEDDING_PROVIDER=hashing
ALLOWED_ORIGINS=https://assistant.example.com
REDIS_URL=redis://redis:6379/0
JOB_TIMEOUT_SECONDS=900
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
TRACE_RETENTION_DAYS=30
